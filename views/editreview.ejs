<% layout("/layouts/boilerplate") %>

<div class="container my-5">
  <h2>Edit Your Review</h2>
  <form action="/bhopal/<%= place %>/review/<%= review._id %>?_method=PUT" method="POST">
    <div class="mb-3">
      <label for="rating" class="form-label">Rating</label>
      <select name="rating" class="form-select" id="rating" required>
        <% for(let i=5; i>=1; i--) { %>
          <option value="<%= i %>" <%= review.rating === i ? 'selected' : '' %>>
            <%= "★".repeat(i) %> - <%= ["Poor", "Fair", "Good", "Very Good", "Excellent"][i - 1] %>
          </option>
        <% } %>
      </select>
    </div>
    <div class="mb-3">
      <label for="comment" class="form-label">Comment</label>
      <textarea name="comment" class="form-control" id="comment" rows="4"><%= review.comment %></textarea>
    </div>
    <button type="submit" class="btn btn-primary">Update Review</button>
  </form>
</div>
