
                  

    
    <% layout("/layouts/boilerplate.ejs") %>
   
    
      <!-- Hero Section -->
      <section class="hero-section d-flex align-items-center justify-content-center text-center">
        <div class="overlay"></div>
        <div class="content px-3">
          <h1 class="display-3 fw-bold mb-3">Discover the Heart of India</h1>
          <p class="lead fs-5 mb-4">Experience the rich heritage, vibrant culture, and natural beauty of Bhopal.</p>
          <a href="#explore" class="btn btn-primary btn-lg px-5 py-3">
            <i class="fas fa-arrow-down me-2"></i>Explore Now
          </a>
        </div>
      </section>
    
      <!-- About Section -->
      <section class="py-5" id="explore">
        <div class="container">
          <div class="row align-items-center g-4">
            <div class="col-md-6 mb-4 mb-md-0">
              <img src="https://upload.wikimedia.org/wikipedia/commons/e/ef/%28Indore_-_Bhopal%29_Intercity_Express_Route_map.jpg" alt="Bhopal Map" class="img-fluid rounded shadow-lg hero-img">
            </div>
            <div class="col-md-6">
              <h2 class="mb-4 fw-bold text-primary">Welcome to Bhopal</h2>
              <p class="fs-5 mb-3 text-muted">Bhopal, the capital city of Madhya Pradesh, is a blend of scenic beauty, historic landmarks, and modern urban planning.</p>
              <p class="fs-5 mb-4 text-muted">From ancient caves and majestic mosques to vibrant bazaars and contemporary museums, Bhopal is a treasure trove for travelers.</p>
              <a href="https://en.wikipedia.org/wiki/Bhopal" class="btn btn-outline-primary btn-lg" target="_blank">
                <i class="fas fa-book me-2"></i>Learn More
              </a>
            </div>
          </div>
        </div>
      </section>
    
      <!-- Attractions Section -->
      <section class="py-5 bg-light" id="attractions">
        <div class="container">
          <h2 class="section-title text-primary">Top Attractions in Bhopal</h2>
          <div class="row g-4">
            <!-- Upper Lake -->
            <div class="col-md-6 col-lg-4">
              <div class="card h-100 shadow-sm">
                <img src="https://tickettolywood.travel.blog/wp-content/uploads/2019/03/e754a-whatsapp2bimage2b2018-05-292bat2b9.01.022bam.jpeg" class="card-img-top" alt="Upper Lake">
                <div class="card-body">
                  <h5 class="card-title"><i class="fas fa-water me-2"></i>Upper Lake (Bhojtal)</h5>
                  <p class="card-text">A historic lake offering serene boat rides and picturesque sunsets.</p>
                  <a class="btn btn-danger w-100" href="/bhopal/upperLake"><i class="fas fa-eye me-2"></i>See More</a>
                </div>
              </div>
            </div>
            
            <!-- Taj-ul-Masajid -->
            <div class="col-md-6 col-lg-4">
                <div class="card h-100 shadow-sm">
                  <img src="https://mapacademy.io/wp-content/uploads/2024/01/taj-ul-masajid-bhopal-margin-image-4s.jpg" class="card-img-top" alt="Taj-ul-Masajid">
                  <div class="card-body">
                    <h5 class="card-title"><i class="fas fa-mosque me-2"></i>Taj-ul-Masajid</h5>
                    <p class="card-text">One of the largest mosques in India, showcasing stunning Mughal architecture</p>
                    <a class="btn btn-danger w-100" href="/bhopal/tajulmasque"><i class="fas fa-eye me-2"></i>See More</a>
                  </div>
                </div>
              </div>
              
              <!-- Bhimbetka Rock Shelters -->
              <div class="col-md-6 col-lg-4">
                <div class="card h-100 shadow-sm">
                  <img src="https://encrypted-tbn0.gstatic.com/images?q=tbn:ANd9GcREwEpOkI5P9P_ZKQtXf4Sw0eLg3E--fh1hdvtHFv309wUrJ2FaTYaMfodhi8Poesv-Y3M&usqp=CAU" class="card-img-top" alt="Bhimbetka">
                  <div class="card-body">
                    <h5 class="card-title"><i class="fas fa-mountain me-2"></i>Bhimbetka Rock Shelters</h5>
                    <p class="card-text">UNESCO World Heritage site with prehistoric cave paintings.</p>
                    <a class="btn btn-danger w-100" href="/bhopal/bhimbetka"><i class="fas fa-eye me-2"></i>See More</a>
                  </div>
                </div>
              </div>
              
              <!-- Van Vihar National Park -->
              <div class="col-md-6 col-lg-4">
                <div class="card h-100 shadow-sm">
                  <img src="https://static.theprint.in/wp-content/uploads/2023/04/ANI-20230423044515.jpg" class="card-img-top" alt="Van Vihar">
                  <div class="card-body">
                    <h5 class="card-title"><i class="fas fa-leaf me-2"></i>Van Vihar National Park</h5>
                    <p class="card-text">A zoological park offering a glimpse of wildlife in natural habitats.</p>
                    <a class="btn btn-danger w-100" href="/bhopal/van"><i class="fas fa-eye me-2"></i>See More</a>
                  </div>
                </div>
              </div>
              
              <!-- Anchi Stupa -->
              <div class="col-md-6 col-lg-4">
                <div class="card h-100 shadow-sm">
                  <img src="https://budgetindianvacations.wordpress.com/wp-content/uploads/2014/07/sanchi-stupa-bhopal.jpg" class="card-img-top" alt="Anchi Stupa">
                  <div class="card-body">
                    <h5 class="card-title"><i class="fas fa-gopuram me-2"></i>Anchi Stupa</h5>
                    <p class="card-text">Ancient Buddhist monument known for its intricate carvings.</p>
                    <a class="btn btn-danger w-100" href="/bhopal/anchi"><i class="fas fa-eye me-2"></i>See More</a>
                  </div>
                </div>
              </div>
              
              <!-- Gohar Mahal -->
              <div class="col-md-6 col-lg-4">
                <div class="card h-100 shadow-sm">
                  <img src="https://www.trawell.in/admin/images/upload/145239559Bhopal_Gohar_Mahal_Main.jpg" class="card-img-top" alt="Gohar Mahal">
                  <div class="card-body">
                    <h5 class="card-title"><i class="fas fa-building me-2"></i>Gohar Mahal</h5>
                    <p class="card-text">A beautiful palace reflecting a blend of Hindu and Mughal architecture</p>
                    <a class="btn btn-danger w-100" href="/bhopal/gohar"><i class="fas fa-eye me-2"></i>See More</a>
                  </div>
                </div>
              </div>
          </div>
        </div>
      </section>
    
      <!-- Hotels Section -->
      <section class="py-5" id="hotels">
        <div class="container">
          <h2 class="section-title text-primary">Plan Your Stay</h2>
          <div class="row g-4">
            <!-- Courtyard by Marriott -->
            <div class="col-md-6 col-lg-3">
              <div class="card h-100 shadow-sm">
                <img src="https://pix10.agoda.net/hotelImages/558017/0/cc202584c8df63a620aecae0352f9a58.jpg" class="card-img-top" alt="Courtyard by Marriott">
                <div class="card-body">
                  <h5 class="card-title"><i class="fas fa-star me-2"></i>Courtyard by Marriott</h5>
                  <p class="card-text">Luxurious rooms with modern amenities and excellent service.</p>
                  <p class="mb-2"><small><i class="fas fa-map-marker-alt me-2 text-danger"></i>MP Nagar</small></p>
                  <p class="mb-3"><strong class="text-success">₹7,900</strong> <small class="text-muted">per night</small></p>
                  <a href="/hotel" class="btn btn-primary w-100"><i class="fas fa-check me-2"></i>Check Availability</a>
                </div>
              </div>
            </div>

            <!-- Radisson Bhopal -->
            <div class="col-md-6 col-lg-3">
                <div class="card h-100 shadow-sm">
                  <img src="https://dynamic-media-cdn.tripadvisor.com/media/photo-o/1d/eb/66/c3/radisson-hotel-bhopal.jpg" class="card-img-top" alt="Radisson Bhopal">
                  <div class="card-body">
                    <h5 class="card-title"><i class="fas fa-star me-2"></i>Radisson Bhopal</h5>
                    <p class="card-text">Elegant hotel offering fine dining and comfortable stays.</p>
                    <p class="mb-2"><small><i class="fas fa-map-marker-alt me-2 text-danger"></i>Arera Hills</small></p>
                    <p class="mb-3"><strong class="text-success">₹9,000</strong> <small class="text-muted">per night</small></p>
                    <a href="/hotel" class="btn btn-primary w-100"><i class="fas fa-check me-2"></i>Check Availability</a>
                  </div>
                </div>
              </div>
              
              <!-- FabHotel Oasis -->
              <div class="col-md-6 col-lg-3">
                <div class="card h-100 shadow-sm">
                  <img src="https://etimg.etb2bimg.com/photo/100720104.cms" class="card-img-top" alt="FabHotel Oasis">
                  <div class="card-body">
                    <h5 class="card-title"><i class="fas fa-hotel me-2"></i>FabHotel Oasis</h5>
                    <p class="card-text">Affordable accommodation with essential facilities.</p>
                    <p class="mb-2"><small><i class="fas fa-map-marker-alt me-2 text-danger"></i>Habibganj</small></p>
                    <p class="mb-3"><strong class="text-success">₹4,500</strong> <small class="text-muted">per night</small></p>
                    <a href="/hotel" class="btn btn-primary w-100"><i class="fas fa-check me-2"></i>Check Availability</a>
                  </div>
                </div>
              </div>
              
              <!-- Hotel Suraj Palace -->
              <div class="col-md-6 col-lg-3">
                <div class="card h-100 shadow-sm">
                  <img src="https://encrypted-tbn0.gstatic.com/images?q=tbn:ANd9GcSnse0LoY422F1zjO9hSrXXCELTCrJySGdrFg&s" class="card-img-top" alt="Hotel Suraj Palace">
                  <div class="card-body">
                    <h5 class="card-title"><i class="fas fa-crown me-2"></i>Hotel Suraj Palace</h5>
                    <p class="card-text">Comfortable rooms with easy access to city attractions.</p>
                    <p class="mb-2"><small><i class="fas fa-map-marker-alt me-2 text-danger"></i>Kolar Road</small></p>
                    <p class="mb-3"><strong class="text-success">₹3,400</strong> <small class="text-muted">per night</small></p>
                    <a href="/hotel" class="btn btn-primary w-100"><i class="fas fa-check me-2"></i>Check Availability</a>
                  </div>
                </div>
              </div>
          </div>
        </div>
      </section>
    
      <!-- Call to Action Section -->
      <section class="py-5 text-white text-center" style="background: linear-gradient(135deg, #0d6efd 0%, #0a58ca 100%);">
        <div class="container">
          <h2 class="display-4 fw-bold mb-4">Ready to Explore Bhopal?</h2>
          <p class="lead fs-5 mb-4">Book your trip now and immerse yourself in the rich tapestry of history, culture, and nature.</p>
          <div class="d-flex flex-column flex-sm-row gap-3 justify-content-center">
            <a href="/bhopal/signup" class="btn btn-light btn-lg px-5">
              <i class="fas fa-user-plus me-2"></i>Sign Up
            </a>
            <a href="/bhopal/loginform" class="btn btn-outline-light btn-lg px-5">
              <i class="fas fa-sign-in-alt me-2"></i>Login
            </a>
          </div>
        </div>
      </section>      
      <script>
        // Ensure images use lazy loading for better performance and responsiveness
        document.addEventListener('DOMContentLoaded', function(){
          document.querySelectorAll('img').forEach(function(img){
            if(!img.hasAttribute('loading')) img.setAttribute('loading','lazy');
          });
        });
      </script>
    