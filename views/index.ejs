
                  
    <% layout("/layouts/boilerplate.ejs") %>
   
    
      <!-- Hero Section -->
      <section class="hero-section d-flex align-items-center justify-content-center text-center ">
        <div class="overlay"></div>
        <div class="content">
          <h1 class="display-4 fw-bold">Discover the Heart of India</h1>
          <p class="lead">Experience the rich heritage, vibrant culture, and natural beauty of Bhopal.</p>
          <a href="#explore" class="btn btn-primary btn-lg mt-3">Explore Now</a>
        </div>
      </section>
    
      <!-- About Section -->
      <section class="py-5 bg-light" id="explore">
        <div class="container">
          <div class="row align-items-center">
            <div class="col-md-6">
              <img src="https://upload.wikimedia.org/wikipedia/commons/e/ef/%28Indore_-_Bhopal%29_Intercity_Express_Route_map.jpg" alt="Bhopal Map" class="img-fluid rounded shadow">
            </div>
            <div class="col-md-6">
              <h2 class="mb-4">Welcome to Bhopal</h2>
              <p>Bhopal, the capital city of Madhya Pradesh, is a blend of scenic beauty, historic landmarks, and modern urban planning.</p>
              <p>From ancient caves and majestic mosques to vibrant bazaars and contemporary museums, Bhopal is a treasure trove for travelers.</p>
              <a href="https://en.wikipedia.org/wiki/Bhopal" class="btn btn-outline-primary mt-3" target="_blank">Learn More</a>
            </div>
          </div>
        </div>
      </section>
    
      <!-- Attractions Section -->
      <section class="py-5" id="attractions">
        <div class="container">
          <h2 class="text-center mb-5">Top Attractions in Bhopal</h2>
          <div class="row g-4">
            <!-- Repeat this block for each attraction -->
            <div class="col-md-6 col-lg-4">
              <div class="card h-100 shadow-sm">
                <img src="https://tickettolywood.travel.blog/wp-content/uploads/2019/03/e754a-whatsapp2bimage2b2018-05-292bat2b9.01.022bam.jpeg" class="card-img-top" alt="Upper Lake">
                <div class="card-body">
                  <h5 class="card-title">Upper Lake (Bhojtal)</h5>
                  <p class="card-text">A historic lake offering serene boat rides and picturesque sunsets.</p>
                  <a class="btn btn-danger" href="/bhopal/upperLake"> See More</a>
                </div>
              </div>
            </div>
            <!-- Add more attraction cards below similarly -->
            <div class="col-md-6 col-lg-4">
                <div class="card h-100 shadow-sm">
                  <img src="https://mapacademy.io/wp-content/uploads/2024/01/taj-ul-masajid-bhopal-margin-image-4s.jpg" class="card-img-top" alt="Upper Lake">
                  <div class="card-body">
                    <h5 class="card-title">Taj-ul-Masajid</h5>
                    <p class="card-text">One of the largest mosques in India, showcasing stunning Mughal architecture</p>
                    <a class="btn btn-danger" href="/bhopal/tajulmasque">See More</a>
                  </div>
                </div>
              </div>
              <div class="col-md-6 col-lg-4">
                <div class="card h-100 shadow-sm">
                  <img src="https://encrypted-tbn0.gstatic.com/images?q=tbn:ANd9GcREwEpOkI5P9P_ZKQtXf4Sw0eLg3E--fh1hdvtHFv309wUrJ2FaTYaMfodhi8Poesv-Y3M&usqp=CAU" class="card-img-top" alt="Upper Lake">
                  <div class="card-body">
                    <h5 class="card-title">Bhimbetka Rock Shelters</h5>
                    <p class="card-text">UNESCO World Heritage site with prehistoric cave paintings.</p>
                    <a class="btn btn-danger" href="/bhopal/bhimbetka">See More</a>
                  </div>
                </div>
              </div>
              <div class="col-md-6 col-lg-4">
                <div class="card h-100 shadow-sm">
                  <img src="https://static.theprint.in/wp-content/uploads/2023/04/ANI-20230423044515.jpg" class="card-img-top" alt="Upper Lake">
                  <div class="card-body">
                    <h5 class="card-title">Van Vihar National Park</h5>
                    <p class="card-text">A zoological park offering a glimpse of wildlife in natural habitats.</p>
                    <a class="btn btn-danger" href="/bhopal/van">See More</a>
                  </div>
                </div>
              </div>
              <div class="col-md-6 col-lg-4">
                <div class="card h-100 shadow-sm">
                  <img src="https://budgetindianvacations.wordpress.com/wp-content/uploads/2014/07/sanchi-stupa-bhopal.jpg" class="card-img-top" alt="Upper Lake">
                  <div class="card-body">
                    <h5 class="card-title">Anchi Stupa</h5>
                    <p class="card-text">Ancient Buddhist monument known for its intricate carvings.</p>
                    <a class="btn btn-danger" href="/bhopal/anchi">See More</a>
                  </div>
                </div>
              </div>
              <div class="col-md-6 col-lg-4">
                <div class="card h-100 shadow-sm">
                  <img src="https://www.trawell.in/admin/images/upload/145239559Bhopal_Gohar_Mahal_Main.jpg" class="card-img-top" alt="Upper Lake">
                  <div class="card-body">
                    <h5 class="card-title">Gohar Mahal</h5>
                    <p class="card-text">A beautiful palace reflecting a blend of Hindu and Mughal architecture</p>
                    <a class="btn btn-danger" href="/bhopal/gohar">See More</a>
                  </div>
                </div>
              </div>
              <!-- <div class="col-md-6 col-lg-4">
                <div class="card h-100 shadow-sm">
                  <img src="https://swikblog.com/wp-content/uploads/2022/08/tribal-museum-1024x717.jpg" class="card-img-top" alt="Upper Lake">
                  <div class="card-body">
                    <h5 class="card-title">Tribal Museum</h5>
                    <p class="card-text">An insightful museum showcasing the culture of tribal communities.</p>
                    <a class="btn btn-danger" href="/bhopal/tribal">See More</a>
                  </div>
                </div>
              </div> -->
          </div>
        </div>
      </section>
    
      <!-- Hotels Section -->
      <section class="py-5 bg-light" id="hotels">
        <div class="container">
          <h2 class="text-center mb-5">Plan Your Stay</h2>
          <div class="row g-4">
            <!-- Repeat this block for each hotel -->
            <div class="col-md-6 col-lg-3">
              <div class="card h-100 shadow-sm">
                <img src="https://pix10.agoda.net/hotelImages/558017/0/cc202584c8df63a620aecae0352f9a58.jpg" class="card-img-top" alt="Courtyard by Marriott">
                <div class="card-body">
                  <h5 class="card-title">Courtyard by Marriott</h5>
                  <p class="card-text">Luxurious rooms with modern amenities and excellent service.</p>
                  <p><strong>Location:</strong> MP Nagar</p>
                  <p><strong>Price:</strong><b class="text-success"> ₹7,900</b> per night</p>
                  <a href="/hotel" class="btn btn-primary mt-2">Check Availability</a>
                </div>
              </div>
            </div>

            <!-- Add more hotel cards similarly -->
            <div class="col-md-6 col-lg-3">
                <div class="card h-100 shadow-sm">
                  <img src="https://dynamic-media-cdn.tripadvisor.com/media/photo-o/1d/eb/66/c3/radisson-hotel-bhopal.jpg" class="card-img-top" alt="Courtyard by Marriott">
                  <div class="card-body">
                    <h5 class="card-title">Radisson Bhopal</h5>
                    <p class="card-text">Elegant hotel offering fine dining and comfortable stays.</p>
                    <p><strong>Location:</strong> Arera Hills</p>
                    <p><strong>Price:</strong> <b class="text-success"> ₹9,000</b> per night</p>
                    <a href="/hotel" class="btn btn-primary mt-2">Check Availability</a>
                  </div>
                </div>
              </div>
              <div class="col-md-6 col-lg-3">
                <div class="card h-100 shadow-sm">
                  <img src="https://etimg.etb2bimg.com/photo/100720104.cms" class="card-img-top" alt="Courtyard by Marriott">
                  <div class="card-body">
                    <h5 class="card-title">FabHotel Oasis</h5>
                    <p class="card-text">Affordable accommodation with essential facilities.</p>
                    <p><strong>Location:</strong> Habibganj</p>
                    <p><strong>Price:</strong> <b class="text-success"> ₹4,500</b> per night</p>
                    <a href="/hotel" class="btn btn-primary mt-2">Check Availability</a>
                  </div>
                </div>
              </div>
              <div class="col-md-6 col-lg-3">
                <div class="card h-100 shadow-sm">
                  <img src="https://encrypted-tbn0.gstatic.com/images?q=tbn:ANd9GcSnse0LoY422F1zjO9hSrXXCELTCrJySGdrFg&s" class="card-img-top" alt="Courtyard by Marriott">
                  <div class="card-body">
                    <h5 class="card-title">Hotel Suraj Palace</h5>
                    <p class="card-text">Comfortable rooms with easy access to city attractions.</p>
                    <p><strong>Location:</strong> Kolar Road</p>
                    <p><strong>Price:</strong><b class="text-success"> ₹3,400</b> per night</p>
                    <a href="/hotel" class="btn btn-primary mt-2">Check Availability</a>
                  </div>
                </div>
              </div>
              </div>
          </div>
        </div>
      </section>
    
      <!-- Call to Action Section -->
      <section class="py-5 text-white text-center" style="background-color: #0d6efd;">
        <div class="container">
          <h2 class="mb-4">Ready to Explore Bhopal?</h2>
          <p class="mb-4">Book your trip now and immerse yourself in the rich tapestry of history, culture, and nature.</p>
          <a href="/bhopal/signup" class="btn btn-light btn-lg me-3">Sign Up</a>
          <a href="/bhopal/login" class="btn btn-outline-light btn-lg">Login</a>
        </div>
      </section>
    
      
    